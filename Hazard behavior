using UnityEngine;

public class Hazard : MonoBehaviour
{
    void OnTriggerEnter2D(Collider2D other)
    {
        if (other.CompareTag("Player"))
        {
            if (GameManager.health > 1)
            {
                GameManager.TakeDamage(1);
                Destroy(gameObject);
            }
            else
            {
                GameManager.TakeDamage(1);
            }
        }
    }
}
