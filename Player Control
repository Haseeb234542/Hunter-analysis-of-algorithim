using UnityEngine;

public class PlayerMovement : MonoBehaviour
{
    public float speed = 5f;
    public float jumpForce = 7f;

    public float leftBoundary = -11f;
    public float rightBoundary = 30f;
    public float deathY = -5f;
    public float respawnOffsetY = 3f;   // Kitna upar respawn
    public float respawnOffsetX = -5f;  // ✅ Kitna peeche respawn (-5 = left side)

    private Rigidbody2D rb;
    private Animator anim;
    private int jumpCount = 0;
    private int maxJumps = 2;
    
    private Vector3 fallPosition;

    void Start()
    {
        rb = GetComponent<Rigidbody2D>();
        anim = GetComponent<Animator>();
    }

    void Update()
    {
        if (GameManager.health <= 0) return;

        float move = Input.GetAxis("Horizontal");

        rb.velocity = new Vector2(move * speed, rb.velocity.y);

        Vector3 pos = transform.position;
        pos.x = Mathf.Clamp(pos.x, leftBoundary, rightBoundary);
        transform.position = pos;

        if (move > 0)
            transform.localScale = new Vector3(1, 1, 1);
        else if (move < 0)
            transform.localScale = new Vector3(-1, 1, 1);

        if (Input.GetKeyDown(KeyCode.Space) && jumpCount < maxJumps)
        {
            rb.velocity = new Vector2(rb.velocity.x, jumpForce);
            jumpCount++;
        }

        anim.SetFloat("Speed", Mathf.Abs(move));
        anim.SetBool("isJumping", jumpCount > 0);

        if (transform.position.y < deathY)
        {
            fallPosition = transform.position;
            
            if (GameManager.health > 1)
            {
                GameManager.TakeDamage(1);
                RespawnAtOffset();
            }
            else
            {
                GameManager.TakeDamage(1);
            }
        }
    }

    void OnCollisionEnter2D(Collision2D collision)
    {
        if (collision.gameObject.CompareTag("Ground"))
        {
            jumpCount = 0;
        }
    }
    
    void RespawnAtOffset()
    {
        // New position: X = fall X + offset, Y = fall Y + offset
        Vector3 newPosition = new Vector3(
            fallPosition.x + respawnOffsetX,  // ✅ X pe offset lagega
            fallPosition.y + respawnOffsetY, 
            0
        );
        
        // Boundary check
        newPosition.x = Mathf.Clamp(newPosition.x, leftBoundary, rightBoundary);
        
        transform.position = newPosition;
        rb.velocity = Vector2.zero;
        jumpCount = 0;
        
        Debug.Log("Player respawned at: " + newPosition);
    }
}
